NODE_ENV=development
APP_ENV=local
APP_PORT=3400
APP_URL=http://localhost:3400

POSTGRES_DB=taplink
POSTGRES_USER=taplink_app
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE
DATABASE_URL=postgresql://taplink_app:CHANGE_ME_WITH_A_LONG_RANDOM_VALUE@postgres:5432/taplink

SESSION_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES
RATE_LIMIT_SECRET=CHANGE_ME_WITH_A_DIFFERENT_32_BYTE_RANDOM_VALUE
ANALYTICS_HASH_KEY=CHANGE_ME_WITH_A_DIFFERENT_32_BYTE_RANDOM_VALUE
ANALYTICS_RETENTION_DAYS=395
ENCRYPTION_KEY=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES
BOOTSTRAP_TOKEN=CHANGE_ME_WITH_A_ONE_TIME_RANDOM_VALUE

STORAGE_DRIVER=filesystem
STORAGE_PATH=/app/data/uploads
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_BUCKET=taplink-private
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

ASAAS_ENVIRONMENT=sandbox
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_SECRET=

# Recuperação de senha: use domínio verificado e segredo exclusivo.
RESEND_API_KEY=
MAIL_FROM=TapLink Negócios <nao-responda@example.com>

# IA opcional: desligada por padrão; nunca reutilize chaves de outro sistema.
AI_INSIGHTS_ENABLED=false
OPENAI_API_KEY=
OPENAI_INSIGHTS_MODEL=gpt-5-mini
